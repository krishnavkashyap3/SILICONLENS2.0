# =============================================================================
# SiliconLens Environment Configuration
# Copy this file to `.env` for local development. Never commit `.env` to Git.
# =============================================================================

# --- Server-Side Configuration (Recommended for Production) ------------------
# Required when running the Express server (`server.ts`) locally, on Cloud Run,
# Render, Railway, or Docker. Kept private on the server and never bundled into
# client-side JavaScript.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Port for the Express server (defaults to 3000)
PORT="3000"

# Comma-separated list of allowed CORS origins when frontend and backend are
# hosted on separate domains (e.g., "https://siliconlens.vercel.app").
# Leave as "*" or omit for open CORS on public API endpoints.
ALLOWED_ORIGIN="*"

# Optional public URL of the hosted application
APP_URL="http://localhost:3000"

# --- Static Frontend Configuration (e.g., Vercel Static Vite Deployments) ----
# Optional: Point the static frontend to an external Express backend URL
# (e.g., "https://siliconlens-api.onrender.com"). Leave empty for same-origin.
VITE_API_BASE_URL=""

# Optional fallback ONLY when deploying a static Vite build (`dist/`) without
# any Node/Express backend. Warning: `VITE_*` variables are embedded into the
# public browser bundle—always restrict this key by HTTP referrer in Google
# Cloud Console if used in production.
VITE_GEMINI_API_KEY=""
